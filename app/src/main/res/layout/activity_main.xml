<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:text="HP 1320 Print Service"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#0F172A"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:text="Set your router or print server connection details. Once saved, this printer appears in Word, Excel, WhatsApp, and Android system print menus."
        android:layout_marginTop="8dp"
        android:textSize="13sp"
        android:textColor="#475569"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:text="Printer / Router IP Address:"
        android:layout_marginTop="20dp"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#1E293B"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/txtIp"
        android:text="192.168.1.1"
        android:textSize="16sp"
        android:inputType="textUri"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:text="RAW Socket Port:"
        android:layout_marginTop="12dp"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#1E293B"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/txtPort"
        android:text="9100"
        android:textSize="16sp"
        android:inputType="number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/btnSave"
        android:text="Save Settings"
        android:layout_marginTop="24dp"
        android:layout_width="match_parent"
        android:layout_height="52dp"/>

    <Button
        android:id="@+id/btnOpenSystemSettings"
        android:text="Open Android Print Settings"
        android:layout_marginTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="52dp"/>

    <TextView
        android:id="@+id/lblStatus"
        android:text="Status: Configured"
        android:textColor="#0284C7"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:textSize="15sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
